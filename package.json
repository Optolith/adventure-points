{
  "name": "@optolith/adventure-points",
  "version": "0.1.2",
  "description": "",
  "license": "MPL-2.0",
  "author": "Lukas Obermann",
  "type": "module",
  "files": [
    "dist/src/**/*.{d.ts,js}"
  ],
  "main": "dist/src/index.js",
  "exports": {
    "./activatable": "./dist/src/activatable.js",
    "./improvement-cost": "./dist/src/improvementCost.js"

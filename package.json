  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "test": "node --import tsx --test",
    "lint": "oxlint",
    "format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "format:check": "oxfmt \"{src,test}/**/*.{ts,tsx}\" --check",
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff"
  },
  "devDependencies": {
    "@elyukai/oxc-config": "^0.1.2",
    "@optolith/database-schema": "^0.111.1",
    "@types/node": "^26.6.5",
    "commit-and-tag-version": "^13.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": "github:Optolith/adventure-points",
  "bugs": {
    "url": "https://github.com/Optolith/adventure-points/issues"
  },
  "dependencies": {
    "@elyukai/utils": "^0.3.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
